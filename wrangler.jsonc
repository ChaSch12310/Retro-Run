{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "retro-run",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
