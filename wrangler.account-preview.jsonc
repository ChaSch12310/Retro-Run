{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "retro-run-account-preview",
  "main": "worker.js",
  "compatibility_date": "2026-07-20",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_STORE",
        "class_name": "AccountStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccountStore"]
    }
  ]
}
