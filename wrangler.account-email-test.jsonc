{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "retro-run-account-email-test",
  "main": "worker.js",
  "compatibility_date": "2026-07-20",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    }
  },
  "vars": {
    "ALLOW_DUPLICATE_EMAILS": "true",
    "EMAIL_FROM": "retrorun@schwartzdev.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["retrorun@schwartzdev.com"],
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_STORE",
        "class_name": "AccountStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccountStore"]
    }
  ]
}
